# 기본: 텍스트 파일은 LF로 통일 (Windows/Mac 혼용 환경)
* text=auto eol=lf

# 명시적 텍스트 파일
*.md        text eol=lf
*.py        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.csv       text eol=lf

# Windows 배치 파일은 CRLF 유지 (Windows에서만 실행)
*.bat       text eol=crlf
*.ps1       text eol=crlf

# 바이너리 파일 (변환 안 함)
*.jpg       binary
*.jpeg      binary
*.png       binary
*.gif       binary
*.ico       binary
*.zip       binary
*.pdf       binary
